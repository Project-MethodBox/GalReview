server {
    listen 80;
    server_name _;

    # FileService accepts files up to 10 MiB. Leave room for multipart fields
    # and boundaries; the application remains the authoritative size check.
    client_max_body_size 12m;
    client_body_timeout 190s;

    location / {
        proxy_pass http://127.0.0.1:5120;
        proxy_http_version 1.1;
        proxy_request_buffering off;
        proxy_connect_timeout 10s;
        proxy_send_timeout 190s;
        proxy_read_timeout 190s;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Correlation-Id $http_x_correlation_id;
    }
}
