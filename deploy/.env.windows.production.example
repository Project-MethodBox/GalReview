# Copy this file to .env.windows.production and replace every CHANGE_ME value.
# MySQL, MongoDB, and Neo4j must already be installed, initialized, and running.

GATEWAY_KEY=CHANGE_ME_GATEWAY_KEY
USER_SERVICE_KEY=CHANGE_ME_USER_SERVICE_KEY
AUTH_SERVICE_KEY=CHANGE_ME_AUTH_SERVICE_KEY
FILE_SERVICE_KEY=CHANGE_ME_FILE_SERVICE_KEY
KNOWLEDGE_SERVICE_KEY=CHANGE_ME_KNOWLEDGE_SERVICE_KEY
GALGAME_SERVICE_KEY=CHANGE_ME_GALGAME_SERVICE_KEY
RENDER_SERVICE_KEY=CHANGE_ME_RENDER_SERVICE_KEY
PRACTICE_SERVICE_KEY=CHANGE_ME_PRACTICE_SERVICE_KEY
CREDIT_SERVICE_KEY=CHANGE_ME_CREDIT_SERVICE_KEY

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
USER_DATABASE_CONNECTION=Server=127.0.0.1;Port=3306;Database=galreview_user;User ID=root;Password=CHANGE_ME;SslMode=Required;AllowPublicKeyRetrieval=True
AUTH_DATABASE_CONNECTION=Server=127.0.0.1;Port=3306;Database=galreview_auth;User ID=root;Password=CHANGE_ME;SslMode=Required;AllowPublicKeyRetrieval=True
CREDIT_DATABASE_CONNECTION=Server=127.0.0.1;Port=3306;Database=qzwl_credit;User ID=root;Password=CHANGE_ME;SslMode=Required;AllowPublicKeyRetrieval=True
USER_SERVICE_MODE=MySql
AUTH_SERVICE_MODE=MySql

MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_CONNECTION_STRING=mongodb://127.0.0.1:27017

NEO4J_HOST=127.0.0.1
NEO4J_PORT=7687
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=CHANGE_ME_NEO4J_PASSWORD
NEO4J_DATABASE=neo4j

GALREVIEW_ADMIN_USERNAME=CHANGE_ME_ADMIN_USERNAME
GALREVIEW_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ACCOUNT_FRONTEND_BASE_URL=https://CHANGE_ME.example.com
CORS_ORIGINS=https://CHANGE_ME.example.com

GATEWAY_PORT=5000
GATEWAY_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=5120
FRONTEND_BIND_ADDRESS=127.0.0.1
STARTUP_TIMEOUT_SECONDS=120
DEFAULT_TIMEOUT_MS=30000
UPLOAD_TIMEOUT_MS=120000
TRUST_PROXY=loopback

SMTP_HOST=
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=千知万理

DEEPSEEK_API_KEY=
GALGAME_NARRATIVE_ENABLED=false
GALGAME_NARRATIVE_ENDPOINT=https://api.deepseek.com/chat/completions
GALGAME_NARRATIVE_MODEL=deepseek-v4-flash
GALGAME_VOICE_ENABLED=false
MIMO_API_KEY=
MIMO_TTS_ENDPOINT=https://api.xiaomimimo.com/v1/chat/completions
MIMO_TTS_MAX_CONCURRENCY=2

PRACTICE_QUESTION_ENDPOINT=https://api.deepseek.com/chat/completions
PRACTICE_QUESTION_MODEL=deepseek-v4-flash
PRACTICE_QUESTION_PARALLELISM=4

OCR_BASE_URL=http://127.0.0.1:5110/
OCR_TIMEOUT_MINUTES=20
