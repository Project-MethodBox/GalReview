{
  "Gateway": {
    "BaseUrl": "http://localhost:5000",
    "ServiceKey": "moonstone-local-gateway-key"
  },
  "ConnectionStrings": {
    "GameDatabase": "mongodb://127.0.0.1:27017"
  },
  "MongoDb": {
    "Database": "moonstone_galgame"
  },
  "GalGameStore": {
    "Provider": "MongoDB"
  },
  "NarrativeGeneration": {
    "Enabled": false,
    "Endpoint": "https://api.deepseek.com/chat/completions",
    "Model": "deepseek-v4-pro",
    "PromptVersion": "galgame-narrative-v2",
    "TimeoutSeconds": 120,
    "MaxOutputTokens": 16000,
    "Temperature": 0.75,
    "MaxDraftAttempts": 2
  }
}
