    "entrySceneId": "scene-001",
    "scenes": [
        {
            "sceneId": "scene-001",
            "title": "谷底的空档案",
            "dialogue": [
                {
                    "speakerId": "艾黎",
                    "text": "上渡桥的守护者说，谷底的田地有一块不明的枯萎。我去查过，土里没有毒，但谷物档案里缺了一段记载。",
                    "emotion": "concerned"
                },
                {
                    "speakerId": "洛恩",
                    "text": "档案是我们的命根子。你说缺了一段，是哪一段？别告诉我是燃烧季的那段，那段从来不会出问题。",
                    "emotion": "guarded"
                },
                {
                    "speakerId": "你",
                    "text": "谷物从播种到成熟会经历幼苗期、分蘘期、拔节期、抽穗期和成熟期。缺的就是分蘘期的记载，恰好是枯萎出现的时期。",
                    "emotion": "focused"
                }
            ],
            "choices": [
                {
                    "choiceId": "c-scene-001-1",
                    "questionId": "71eaf449-6263-4e05-a059-170f55a0692b",
                    "text": "先把生长阶段顺序拼完，再去现场看枯萎",
                    "nextSceneId": "scene-002",
                    "scoreDelta": 0,
                    "knowledgePointId": "d1adc45a-52db-4de2-9cf7-02e1ac0d53cb"
                }
            ],
            "knowledgeBindings": [
                {
                    "knowledgePointId": "d1adc45a-52db-4de2-9cf7-02e1ac0d53cb",
                    "questionId": "71eaf449-6263-4e05-a059-170f55a0692b",
                    "purpose": "FEEDBACK"
                }
            ]
        },
        {
            "sceneId": "scene-002",
            "title": "折叠的羊皮纸",
            "dialogue": [
                {
                    "speakerId": "艾黎",
                    "text": "我在档案柜的夹层里找到了一张折叠的羊皮纸。上面的字迹被水浇过，但能辨认出「分蘘」两个字。",
                    "emotion": "hopeful"
                },
                {
                    "speakerId": "你",
                    "text": "幼苗期之后就是分蘘期，这段是记载的断口。如果顺序拼错，后面的判断全会走偏。",
                    "emotion": "calm"
                },
                {
                    "speakerId": "洛恩",
                    "text": "羊皮纸的背面还有字。写的是分蘘期的管理要点，但有一句被滑笔涂掉了。你们看看能不能入这个空缺。",
                    "emotion": "curious"
                }
            ],
            "choices": [
                {
                    "choiceId": "c-scene-002-1",
                    "questionId": "7b61787a-a6a1-4836-8531-e621eae47ec2",
                    "text": "用生长阶段顺序定位记载断口，再补入缺失的要点",
                    "nextSceneId": "scene-003",
                    "scoreDelta": 0,
                    "knowledgePointId": "84f7d873-e573-4689-b18d-6f82c745d1bf"
                }
            ],
            "knowledgeBindings": [
                {
                    "knowledgePointId": "84f7d873-e573-4689-b18d-6f82c745d1bf",
                    "questionId": "7b61787a-a6a1-4836-8531-e621eae47ec2",
                    "purpose": "EXPLAIN"
                }
            ]
        },
        {
            "sceneId": "scene-003",
            "title": "一次决定",
            "dialogue": [
                {
                    "speakerId": "洛恩",
                    "text": "上渡桥的守护者送了消息，谷底的灌溉只能维持十分钟，之后要让给上游的村庄。你只有一次调配的机会。",
                    "emotion": "urgent"
                },
                {
                    "speakerId": "艾黎",
                    "text": "如果只浅灌不施肥，分蘘会徒长但根系浮浅。如果只施肥不灌水，肥料封在土表。你得告诉我们怎么用这十分钟。",
                    "emotion": "pressured"
                },
                {
                    "speakerId": "你",
                    "text": "分蘘期的管理不能只看一个方向。如果只顾群体数量，个体长不壮；如果只顾个体，群体又散了。水和肥得同时起作用。",
                    "emotion": "decisive"
                }
            ],
            "choices": [
                {
                    "choiceId": "c-scene-003-correct",
                    "questionId": "0fa69ae0-164b-4886-ab08-9765d80926ce",
                    "text": "协调群体数量与个体生长，同时调整水肥促进有效分蘘",
                    "nextSceneId": "scene-004",
                    "scoreDelta": 1,
                    "answerKind": "CHOICE",
                    "correct": true,
                    "knowledgePointId": "d1adc45a-52db-4de2-9cf7-02e1ac0d53cb"
                },
                {
                    "choiceId": "c-scene-003-d1",
                    "questionId": "0fa69ae0-164b-4886-ab08-9765d80926ce",
                    "text": "拔节期、抽穗期和成熟期是后续阶段，与分蘘期管理关系不大",
                    "nextSceneId": "scene-004",
                    "scoreDelta": 0,
                    "answerKind": "CHOICE",
                    "correct": false,
                    "knowledgePointId": "d1adc45a-52db-4de2-9cf7-02e1ac0d53cb"
                },
                {
                    "choiceId": "c-scene-003-d2",
                    "questionId": "0fa69ae0-164b-4886-ab08-9765d80926ce",
                    "text": "该管理方法仅适用于理论考试，实际生产中无参考价值",
                    "nextSceneId": "scene-004",
                    "scoreDelta": 0,
                    "answerKind": "CHOICE",
                    "correct": false,
                    "knowledgePointId": "d1adc45a-52db-4de2-9cf7-02e1ac0d53cb"
                },
                {
                    "choiceId": "c-scene-003-d3",
                    "questionId": "0fa69ae0-164b-4886-ab08-9765d80926ce",
                    "text": "需要结合具体地区气候条件才能判断其适用性",
                    "nextSceneId": "scene-004",
                    "scoreDelta": 0,
                    "answerKind": "CHOICE",
                    "correct": false,
                    "knowledgePointId": "d1adc45a-52db-4de2-9cf7-02e1ac0d53cb"
                }
            ],
            "knowledgeBindings": [
                {
                    "knowledgePointId": "d1adc45a-52db-4de2-9cf7-02e1ac0d53cb",
                    "questionId": "0fa69ae0-164b-4886-ab08-9765d80926ce",
                    "purpose": "QUESTION"
                }
            ]
        },
        {
            "sceneId": "scene-004",
            "title": "灌溉停下以后",
            "dialogue": [
                {
                    "speakerId": "洛恩",
                    "text": "灌溉停了，但分蘘的长势和根系都笼住了。谷底的枯萎区域已经扩散停住了。",
                    "emotion": "relieved"
                },
                {
                    "speakerId": "艾黎",
                    "text": "被涑掉的那句话我在羊皮纸的另一面找到了。你的生长阶段还原让整个档案对上了。这不是背书，是真的救了谷底。",
                    "emotion": "grateful"
                }
            ],
            "choices": [],
            "knowledgeBindings": []
        }
    ],
