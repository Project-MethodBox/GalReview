        {
            "sceneId": "scene-002",
            "title": "知识模块 A：水稻基本生长周期",
            "dialogue": [
                {
                    "speakerId": "NEXUS",
                    "text": "在进入第一个评估节点之前，系统将输出「水稻基本生长周期」的知识摘要。",
                    "emotion": "thoughtful"
                },
                {
                    "speakerId": "NEXUS",
                    "text": "水稻从播种到成熟的完整生长周期，包括幼苗期、分蘖期、拔节期、抽穗期和成熟期。每个阶段对应不同的生理特征和管理要求。",
                    "emotion": "explaining"
                },
                {
                    "speakerId": "NEXUS",
                    "text": "该摘要将作为后续评估的知识基准。请确认已读取。",
                    "emotion": "informative"
                }
            ],
            "choices": [
                {
                    "choiceId": "c-scene-002-1",
                    "questionId": "208b95d5-0a4d-4431-81ba-b18ca0528609",
                    "text": "了解了，继续。",
                    "nextSceneId": "scene-003",
                    "scoreDelta": 0,
                    "knowledgePointId": "84f7d873-e573-4689-b18d-6f82c745d1bf"
                }
            ],
            "knowledgeBindings": [
