        {
            "sceneId": "scene-003",
            "title": "评估节点 1：水稻分蘖期管理",
            "dialogue": [
                {
                    "speakerId": "NEXUS",
                    "text": "系统已生成评估问题，请作答。",
                    "emotion": "challenging"
                },
                {
                    "speakerId": "NEXUS",
                    "text": "关于「水稻分蘖期管理」，以下哪个说法是正确的？",
                    "emotion": "questioning"
                }
            ],
            "choices": [
                {
                    "choiceId": "c-scene-003-d1",
                    "questionId": "ff1605dd-95aa-44a0-aed0-540a3fc8b80a",
                    "text": "分蘖期应深水灌溉以促进分蘖芽萌发，水深保持 10cm 以上",
                    "nextSceneId": "scene-004",
                    "scoreDelta": 0,
                    "knowledgePointId": "d1adc45a-52db-4de2-9cf7-02e1ac0d53cb",
                    "answerKind": "CHOICE",
                    "correct": false
                },
                {
                    "choiceId": "c-scene-003-d2",
                    "questionId": "ff1605dd-95aa-44a0-aed0-540a3fc8b80a",
                    "text": "分蘖期管理的核心是尽早追施大量氮肥，使分蘖数越多越好",
                    "nextSceneId": "scene-004",
                    "scoreDelta": 0,
                    "knowledgePointId": "d1adc45a-52db-4de2-9cf7-02e1ac0d53cb",
                    "answerKind": "CHOICE",
                    "correct": false
                },
                {
                    "choiceId": "c-scene-003-d3",
                    "questionId": "ff1605dd-95aa-44a0-aed0-540a3fc8b80a",
                    "text": "分蘖期不需要水分管理，保持自然降雨即可",
                    "nextSceneId": "scene-004",
                    "scoreDelta": 0,
                    "knowledgePointId": "d1adc45a-52db-4de2-9cf7-02e1ac0d53cb",
                    "answerKind": "CHOICE",
                    "correct": false
                },
                {
                    "choiceId": "c-scene-003-correct",
                    "questionId": "ff1605dd-95aa-44a0-aed0-540a3fc8b80a",
                    "text": "协调群体数量与个体生长，通过水肥调控促进有效分蘖，控制无效分蘖",
                    "nextSceneId": "scene-004",
                    "scoreDelta": 1,
                    "knowledgePointId": "d1adc45a-52db-4de2-9cf7-02e1ac0d53cb",
                    "answerKind": "CHOICE",
                    "correct": true
