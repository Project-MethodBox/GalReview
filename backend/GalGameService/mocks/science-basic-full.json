        {
            "sceneId": "scene-005",
            "title": "知识模块 B：水稻拔节期与抽穗期",
            "dialogue": [
                {
                    "speakerId": "NEXUS",
                    "text": "系统将输出「水稻拔节期与抽穗期」的知识摘要。",
                    "emotion": "thoughtful"
                },
                {
                    "speakerId": "NEXUS",
                    "text": "拔节期是茎秆快速生长的阶段，需要保持田间浅水层，注意防止倒伏，适当控制氮肥。过量施氮会导致茎秆徒长而柔弱。",
                    "emotion": "explaining"
                },
                {
                    "speakerId": "NEXUS",
                    "text": "抽穗期是决定穗粒数的关键时期，需要保证充足的水分供应和适当的追肥。两个阶段共同决定了最终的产量构成。",
                    "emotion": "informative"
                }
            ],
            "choices": [
                {
                    "choiceId": "c-scene-005-1",
                    "questionId": "64b9ab7c-0e95-41dc-8990-ef1779e1ff5b",
                    "text": "知识摘要已读取，继续。",
                    "nextSceneId": "scene-006",
                    "scoreDelta": 0,
                    "knowledgePointId": "f6a7b8c9-d0e1-4f2a-3b4c-5d6e7f8090a0"
                }
            ],
            "knowledgeBindings": [
                {
                    "knowledgePointId": "f6a7b8c9-d0e1-4f2a-3b4c-5d6e7f8090a0",
                    "purpose": "EXPLAIN",
                    "questionId": null
                }
            ]
        },
        {
            "sceneId": "scene-006",
            "title": "评估节点 2：水稻拔节期管理要点",
            "dialogue": [
                {
                    "speakerId": "NEXUS",
                    "text": "系统已生成评估问题，请作答。",
                    "emotion": "challenging"
                },
                {
                    "speakerId": "NEXUS",
                    "text": "关于「水稻拔节期管理」，以下哪个说法是正确的？",
                    "emotion": "questioning"
                }
            ],
            "choices": [
                {
                    "choiceId": "c-scene-006-correct",
                    "questionId": "2c13d08b-98ad-4fb5-b071-6c4468572df0",
                    "text": "拔节期需保持田间浅水层，注意防止倒伏，适当控制氮肥以防茎秆徒长",
                    "nextSceneId": "scene-007",
                    "scoreDelta": 1,
                    "knowledgePointId": "f6a7b8c9-d0e1-4f2a-3b4c-5d6e7f8090a0",
                    "answerKind": "CHOICE",
                    "correct": true
                },
                {
                    "choiceId": "c-scene-006-d2",
                    "questionId": "2c13d08b-98ad-4fb5-b071-6c4468572df0",
                    "text": "拔节期主要管理目标是促进分蘖大量发生，增加有效穗数",
                    "nextSceneId": "scene-007",
                    "scoreDelta": 0,
                    "knowledgePointId": "f6a7b8c9-d0e1-4f2a-3b4c-5d6e7f8090a0",
                    "answerKind": "CHOICE",
                    "correct": false
                },
                {
                    "choiceId": "c-scene-006-d3",
                    "questionId": "2c13d08b-98ad-4fb5-b071-6c4468572df0",
                    "text": "拔节期对水分和养分需求不大，可以减少灌溉和施肥",
                    "nextSceneId": "scene-007",
                    "scoreDelta": 0,
                    "knowledgePointId": "f6a7b8c9-d0e1-4f2a-3b4c-5d6e7f8090a0",
                    "answerKind": "CHOICE",
                    "correct": false
                },
                {
                    "choiceId": "c-scene-006-d1",
                    "questionId": "2c13d08b-98ad-4fb5-b071-6c4468572df0",
                    "text": "拔节期应排水晒田至土壤开裂，促进根系向深层下扎",
                    "nextSceneId": "scene-007",
                    "scoreDelta": 0,
                    "knowledgePointId": "f6a7b8c9-d0e1-4f2a-3b4c-5d6e7f8090a0",
                    "answerKind": "CHOICE",
                    "correct": false
                }
            ],
            "knowledgeBindings": [
                {
                    "knowledgePointId": "f6a7b8c9-d0e1-4f2a-3b4c-5d6e7f8090a0",
                    "purpose": "QUESTION",
