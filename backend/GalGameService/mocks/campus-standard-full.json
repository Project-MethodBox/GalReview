        {
            "sceneId": "scene-005",
            "title": "知识点讲解：水稻拔节期与抽穗期",
            "dialogue": [
                {
                    "speakerId": "林学姐",
                    "text": "分蘖期之后就是拔节期和抽穗期了。这两个阶段对水分和养分的需求很高，是决定产量的关键期。",
                    "emotion": "thoughtful"
                },
                {
                    "speakerId": "林学姐",
                    "text": "拔节期是茎秆快速伸长的阶段，此时需要保持田间有浅水层，同时注意防止倒伏，适当控制氮肥，避免茎秆徒长而柔弱。",
                    "emotion": "explaining"
                },
                {
                    "speakerId": "林学姐",
                    "text": "抽穗期则是决定穗粒数的关键时期，需要保证充足的水分供应和适当的追肥。两个阶段共同决定了最终的产量构成。",
                    "emotion": "informative"
                }
            ],
            "choices": [
                {
                    "choiceId": "c-scene-005-1",
                    "questionId": "88a62541-f6b3-4a09-800d-38082f95e282",
                    "text": "明白了，出题吧！",
                    "nextSceneId": "scene-006",
                    "scoreDelta": 0,
                    "knowledgePointId": "f6a7b8c9-d0e1-4f2a-3b4c-5d6e7f8090a0"
                }
            ],
            "knowledgeBindings": [
                {
                    "knowledgePointId": "f6a7b8c9-d0e1-4f2a-3b4c-5d6e7f8090a0",
                    "purpose": "EXPLAIN",
                    "questionId": null
                }
            ]
        },
        {
            "sceneId": "scene-006",
            "title": "复习题：水稻拔节期管理要点",
            "dialogue": [
                {
                    "speakerId": "林学姐",
                    "text": "第二道题来了！这次考的是拔节期的管理要点。关键词是「浅水层」「防倒伏」「控氮肥」，想想为什么。",
                    "emotion": "challenging"
                },
                {
                    "speakerId": "林学姐",
                    "text": "根据所学内容，关于「水稻拔节期管理」最准确的描述是？",
                    "emotion": "questioning"
                }
            ],
            "choices": [
                {
                    "choiceId": "c-scene-006-d2",
                    "questionId": "851660b2-30b1-4751-8d11-6cb8675aa946",
                    "text": "拔节期主要管理目标是促进分蘖大量发生，增加有效穗数",
                    "nextSceneId": "scene-007",
                    "scoreDelta": 0,
                    "knowledgePointId": "f6a7b8c9-d0e1-4f2a-3b4c-5d6e7f8090a0",
                    "answerKind": "CHOICE",
                    "correct": false
                },
                {
                    "choiceId": "c-scene-006-correct",
                    "questionId": "851660b2-30b1-4751-8d11-6cb8675aa946",
                    "text": "拔节期需保持田间浅水层，注意防止倒伏，适当控制氮肥以防茎秆徒长",
                    "nextSceneId": "scene-007",
                    "scoreDelta": 1,
                    "knowledgePointId": "f6a7b8c9-d0e1-4f2a-3b4c-5d6e7f8090a0",
                    "answerKind": "CHOICE",
                    "correct": true
                },
                {
                    "choiceId": "c-scene-006-d3",
                    "questionId": "851660b2-30b1-4751-8d11-6cb8675aa946",
                    "text": "拔节期对水分和养分需求不大，可以减少灌溉和施肥",
                    "nextSceneId": "scene-007",
                    "scoreDelta": 0,
                    "knowledgePointId": "f6a7b8c9-d0e1-4f2a-3b4c-5d6e7f8090a0",
                    "answerKind": "CHOICE",
                    "correct": false
                },
                {
                    "choiceId": "c-scene-006-d1",
                    "questionId": "851660b2-30b1-4751-8d11-6cb8675aa946",
                    "text": "拔节期应排水晒田至土壤开裂，促进根系向深层下扎",
                    "nextSceneId": "scene-007",
                    "scoreDelta": 0,
                    "knowledgePointId": "f6a7b8c9-d0e1-4f2a-3b4c-5d6e7f8090a0",
                    "answerKind": "CHOICE",
                    "correct": false
                }
            ],
            "knowledgeBindings": [
                {
                    "knowledgePointId": "f6a7b8c9-d0e1-4f2a-3b4c-5d6e7f8090a0",
                    "purpose": "QUESTION",
                    "questionId": "851660b2-30b1-4751-8d11-6cb8675aa946"
                }
            ]
        },
        {
            "sceneId": "scene-007",
            "title": "最后一道题：水稻成熟期判断",
            "dialogue": [
                {
                    "speakerId": "林学姐",
                    "text": "还有最后一道题！这次考成熟期的判断标准。提示：成熟期不是只看叶子颜色那么简单哦。",
                    "emotion": "playful"
                },
                {
                    "speakerId": "林学姐",
                    "text": "关于「水稻成熟期的判断标准」，以下哪个说法是正确的？",
                    "emotion": "questioning"
                }
            ],
            "choices": [
                {
                    "choiceId": "c-scene-007-d3",
                    "questionId": "418fb93b-c9cb-4d43-9ccb-8909bf7480c2",
                    "text": "成熟期判断与籽粒含水量无关，主要看穗部颜色变化",
                    "nextSceneId": "scene-008",
                    "scoreDelta": 0,
                    "knowledgePointId": "c9d0e1f2-a3b4-4c5d-6e7f-8090a1b2c3d3",
                    "answerKind": "CHOICE",
                    "correct": false
                },
                {
                    "choiceId": "c-scene-007-correct",
                    "questionId": "418fb93b-c9cb-4d43-9ccb-8909bf7480c2",
                    "text": "水稻成熟期分为乳熟期、蜡熟期和完熟期，完熟期籽粒含水量降至 20%~25%，是最佳收获期",
                    "nextSceneId": "scene-008",
                    "scoreDelta": 1,
                    "knowledgePointId": "c9d0e1f2-a3b4-4c5d-6e7f-8090a1b2c3d3",
                    "answerKind": "CHOICE",
                    "correct": true
                },
                {
                    "choiceId": "c-scene-007-d2",
                    "questionId": "418fb93b-c9cb-4d43-9ccb-8909bf7480c2",
                    "text": "乳熟期籽粒充满乳浆时是最佳收获期，此时产量最高",
                    "nextSceneId": "scene-008",
                    "scoreDelta": 0,
                    "knowledgePointId": "c9d0e1f2-a3b4-4c5d-6e7f-8090a1b2c3d3",
                    "answerKind": "CHOICE",
                    "correct": false
                },
                {
                    "choiceId": "c-scene-007-d1",
                    "questionId": "418fb93b-c9cb-4d43-9ccb-8909bf7480c2",
                    "text": "成熟期只需观察叶片是否全部变黄即可决定收获时间",
                    "nextSceneId": "scene-008",
                    "scoreDelta": 0,
                    "knowledgePointId": "c9d0e1f2-a3b4-4c5d-6e7f-8090a1b2c3d3",
                    "answerKind": "CHOICE",
                    "correct": false
                }
            ],
