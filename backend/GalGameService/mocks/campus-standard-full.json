        {
            "sceneId": "scene-002",
            "title": "知识点讲解：水稻基本生长周期",
            "dialogue": [
                {
                    "speakerId": "林学姐",
                    "text": "在正式做题之前，我们先回顾一下「水稻基本生长周期」，这可是后面所有题目的基础。",
                    "emotion": "thoughtful"
                },
                {
                    "speakerId": "林学姐",
                    "text": "水稻从播种到成熟，完整经历五个阶段：幼苗期、分蘖期、拔节期、抽穗期和成熟期。每个阶段都有不同的生理特征和管理重点。",
                    "emotion": "explaining"
                },
                {
                    "speakerId": "林学姐",
                    "text": "比如分蘖期关注群体数量，抽穗期关注水分供应。记住这个大框架，等下做题就不会一头雾水了。",
                    "emotion": "informative"
                }
            ],
            "choices": [
                {
                    "choiceId": "c-scene-002-1",
                    "questionId": "802d68e4-5f8c-4a84-a191-21c6a61a0cc3",
                    "text": "了解了，继续。",
                    "nextSceneId": "scene-003",
                    "scoreDelta": 0,
                    "knowledgePointId": "84f7d873-e573-4689-b18d-6f82c745d1bf"
                }
            ],
            "knowledgeBindings": [
                {
                    "knowledgePointId": "84f7d873-e573-4689-b18d-6f82c745d1bf",
                    "purpose": "EXPLAIN",
                    "questionId": null
                }
            ]
        },
        {
            "sceneId": "scene-003",
            "title": "复习题：水稻分蘖期管理",
            "dialogue": [
                {
                    "speakerId": "林学姐",
                    "text": "好，第一道题来了！这道题考的是分蘖期的管理。想想刚才讲过的五个阶段，分蘖期排在第二位，它的管理目标是什么呢？",
                    "emotion": "challenging"
                },
                {
                    "speakerId": "林学姐",
                    "text": "根据所学内容，关于「水稻分蘖期管理」最准确的描述是？",
                    "emotion": "questioning"
                }
            ],
            "choices": [
                {
                    "choiceId": "c-scene-003-d2",
                    "questionId": "bfc7e572-f1df-4474-8965-f0066db84f10",
                    "text": "分蘖期管理的核心是尽早追施大量氮肥，使分蘖数越多越好",
                    "nextSceneId": "scene-004",
                    "scoreDelta": 0,
                    "knowledgePointId": "d1adc45a-52db-4de2-9cf7-02e1ac0d53cb",
                    "answerKind": "CHOICE",
                    "correct": false
                },
                {
                    "choiceId": "c-scene-003-correct",
                    "questionId": "bfc7e572-f1df-4474-8965-f0066db84f10",
                    "text": "协调群体数量与个体生长，通过水肥调控促进有效分蘖，控制无效分蘖",
                    "nextSceneId": "scene-004",
                    "scoreDelta": 1,
                    "knowledgePointId": "d1adc45a-52db-4de2-9cf7-02e1ac0d53cb",
                    "answerKind": "CHOICE",
                    "correct": true
                },
                {
                    "choiceId": "c-scene-003-d3",
                    "questionId": "bfc7e572-f1df-4474-8965-f0066db84f10",
                    "text": "分蘖期不需要水分管理，保持自然降雨即可",
                    "nextSceneId": "scene-004",
                    "scoreDelta": 0,
                    "knowledgePointId": "d1adc45a-52db-4de2-9cf7-02e1ac0d53cb",
                    "answerKind": "CHOICE",
                    "correct": false
                },
                {
                    "choiceId": "c-scene-003-d1",
                    "questionId": "bfc7e572-f1df-4474-8965-f0066db84f10",
                    "text": "分蘖期应深水灌溉以促进分蘖芽萌发，水深保持 10cm 以上",
                    "nextSceneId": "scene-004",
                    "scoreDelta": 0,
                    "knowledgePointId": "d1adc45a-52db-4de2-9cf7-02e1ac0d53cb",
                    "answerKind": "CHOICE",
                    "correct": false
                }
            ],
            "knowledgeBindings": [
                {
                    "knowledgePointId": "d1adc45a-52db-4de2-9cf7-02e1ac0d53cb",
                    "purpose": "QUESTION",
                    "questionId": "bfc7e572-f1df-4474-8965-f0066db84f10"
                }
            ]
        },
