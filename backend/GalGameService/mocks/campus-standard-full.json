        {
            "sceneId": "scene-001",
            "title": "图书馆的自习时光",
            "dialogue": [
                {
                    "speakerId": "林学姐",
                    "text": "嘿，学弟！今天又是复习日呢。学姐已经占到图书馆老位置啦，窗边的那个，阳光正好。",
                    "emotion": "cheerful"
                },
                {
                    "speakerId": "林学姐",
                    "text": "今天我们要系统复习「水稻」的相关知识，从生长周期到田间管理，一共三道题。",
                    "emotion": "encouraging"
                },
                {
                    "speakerId": "林学姐",
                    "text": "放心，学姐会带你一步步走完的。每道题之前我都会先帮你梳理知识点，不用紧张。准备好了就开始吧！",
                    "emotion": "warm"
                }
            ],
            "choices": [
                {
                    "choiceId": "c-scene-001-1",
                    "questionId": "ec09b73b-7097-4eeb-8896-a08b3036ec1c",
                    "text": "准备好了，开始吧！",
                    "nextSceneId": "scene-002",
