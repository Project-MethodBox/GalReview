                }
            ]
        },
        {
            "sceneId": "scene-007",
            "title": "试炼完成",
            "dialogue": [
                {
                    "speakerId": "精灵导师艾莉娅",
                    "text": "你的智慧之光闪耀夺目，三重试炼圆满完成！「丰收之印」已铭刻于你的灵魂。",
