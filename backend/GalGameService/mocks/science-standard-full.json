    "entrySceneId": "scene-001",
    "scenes": [
        {
            "sceneId": "scene-001",
            "title": "绿色面板的闪烁",
            "dialogue": [
                {
                    "speakerId": "NEXUS",
                    "text": "水稻水培舱的生长曲线出现异常下降。数据库中该阶段的记录被标记为待审核，原因是上一班未完成交接。",
                    "emotion": "alert"
                },
                {
                    "speakerId": "姚真",
                    "text": "我看过了，是分蘘阶段的数据丢失了。上一班的姚真——也就是我——在制冷回路跳闸的时候打开过舱门，可能抖动了传感器。",
                    "emotion": "uneasy"
                },
                {
                    "speakerId": "你",
                    "text": "水稻从播种到成熟会经历幼苗期、分蘘期、拔节期、抽穗期和成熟期。丢失的就是分蘘期的记录，这个阶段的管理参数最关键。",
                    "emotion": "focused"
                }
            ],
            "choices": [
                {
                    "choiceId": "c-scene-001-1",
                    "questionId": "71eaf449-6263-4e05-a059-170f55a0692b",
                    "text": "先按生长阶段顺序梳理现有数据，再定位缺失段",
                    "nextSceneId": "scene-002",
                    "scoreDelta": 0,
                    "knowledgePointId": "d1adc45a-52db-4de2-9cf7-02e1ac0d53cb"
                }
            ],
            "knowledgeBindings": [
                {
                    "knowledgePointId": "d1adc45a-52db-4de2-9cf7-02e1ac0d53cb",
                    "questionId": "71eaf449-6263-4e05-a059-170f55a0692b",
                    "purpose": "FEEDBACK"
                }
            ]
        },
        {
            "sceneId": "scene-002",
            "title": "备份日志的缝隙",
            "dialogue": [
                {
                    "speakerId": "NEXUS",
                    "text": "备份服务器中检索到了部分分蘘期记录。数据片段被切断为两段，中间有一个时间空缺。",
                    "emotion": "processing"
                },
                {
                    "speakerId": "你",
                    "text": "幼苗期之后就是分蘘期，这段正是记录的缝隙。如果顺序错了，后面的营养液浓度判断都会失去参照。",
                    "emotion": "calm"
                },
                {
                    "speakerId": "姚真",
                    "text": "我在本地终端的缓存里找到了一条未同步的管理参数记录，上面标注的是分蘘期的要点。但有一行被乱码覆盖了，你看看能不能还原。",
                    "emotion": "hopeful"
                }
            ],
            "choices": [
                {
                    "choiceId": "c-scene-002-1",
                    "questionId": "7b61787a-a6a1-4836-8531-e621eae47ec2",
                    "text": "用生长阶段顺序定位记录缝隙，再还原缺失的参数",
                    "nextSceneId": "scene-003",
                    "scoreDelta": 0,
                    "knowledgePointId": "84f7d873-e573-4689-b18d-6f82c745d1bf"
                }
            ],
            "knowledgeBindings": [
                {
                    "knowledgePointId": "84f7d873-e573-4689-b18d-6f82c745d1bf",
                    "questionId": "7b61787a-a6a1-4836-8531-e621eae47ec2",
                    "purpose": "EXPLAIN"
                }
            ]
        },
        {
            "sceneId": "scene-003",
            "title": "十分钟的窗口",
            "dialogue": [
                {
                    "speakerId": "NEXUS",
                    "text": "制冷回路的隔离阀将在十分钟后关闭。此期间营养液供应可以重新连接，但浓度只能调一次。",
                    "emotion": "warning"
                },
                {
                    "speakerId": "姚真",
                    "text": "如果只调水位不调浓度，分蘘会徒长但根系偏弱。如果只调浓度不调水位，营养液无法均匀漫透。你要怎么用这个窗口？",
                    "emotion": "pressured"
                },
                {
                    "speakerId": "你",
                    "text": "分蘘期的管理不能只看一个方向。如果只顾群体数量，个体长不壮；如果只顾个体，群体又散了。水位和浓度得同步调整，不能只动一个参数。",
                    "emotion": "decisive"
                }
            ],
            "choices": [
                {
                    "choiceId": "c-scene-003-correct",
                    "questionId": "0fa69ae0-164b-4886-ab08-9765d80926ce",
                    "text": "协调群体数量与个体生长，同时调整水肥促进有效分蘘",
                    "nextSceneId": "scene-004",
                    "scoreDelta": 1,
                    "answerKind": "CHOICE",
                    "correct": true,
                    "knowledgePointId": "d1adc45a-52db-4de2-9cf7-02e1ac0d53cb"
                },
                {
                    "choiceId": "c-scene-003-d1",
                    "questionId": "0fa69ae0-164b-4886-ab08-9765d80926ce",
                    "text": "拔节期、抽穗期和成熟期是后续阶段，与分蘘期管理关系不大",
                    "nextSceneId": "scene-004",
                    "scoreDelta": 0,
                    "answerKind": "CHOICE",
                    "correct": false,
                    "knowledgePointId": "d1adc45a-52db-4de2-9cf7-02e1ac0d53cb"
                },
                {
                    "choiceId": "c-scene-003-d2",
                    "questionId": "0fa69ae0-164b-4886-ab08-9765d80926ce",
                    "text": "该管理方法仅适用于理论考试，实际生产中无参考价值",
                    "nextSceneId": "scene-004",
                    "scoreDelta": 0,
                    "answerKind": "CHOICE",
                    "correct": false,
                    "knowledgePointId": "d1adc45a-52db-4de2-9cf7-02e1ac0d53cb"
                },
                {
                    "choiceId": "c-scene-003-d3",
                    "questionId": "0fa69ae0-164b-4886-ab08-9765d80926ce",
                    "text": "需要结合具体地区气候条件才能判断其适用性",
                    "nextSceneId": "scene-004",
                    "scoreDelta": 0,
                    "answerKind": "CHOICE",
                    "correct": false,
                    "knowledgePointId": "d1adc45a-52db-4de2-9cf7-02e1ac0d53cb"
                }
            ],
            "knowledgeBindings": [
                {
                    "knowledgePointId": "d1adc45a-52db-4de2-9cf7-02e1ac0d53cb",
                    "questionId": "0fa69ae0-164b-4886-ab08-9765d80926ce",
                    "purpose": "QUESTION"
                }
            ]
        },
        {
            "sceneId": "scene-004",
            "title": "隔离阀关闭以后",
            "dialogue": [
                {
                    "speakerId": "NEXUS",
                    "text": "隔离阀已关闭。营养液供应恢复正常，分蘘的生长曲线回升。丢失的参数已被本地缓存补入。",
                    "emotion": "stable"
                },
                {
                    "speakerId": "姚真",
                    "text": "被乱码覆盖的那行我在缓存的快照里找到了。你的生长阶段还原让整个数据库对上了。这不是复述手册，是真的解决了问题。",
                    "emotion": "grateful"
                }
            ],
            "choices": [],
            "knowledgeBindings": []
        }
