# Copy to .env, replace every CHANGE_ME value, and keep .env out of Git.
COMPOSE_PROJECT_NAME=galreview-production

GATEWAY_KEY=CHANGE_ME_GATEWAY_KEY
USER_SERVICE_KEY=CHANGE_ME_USER_SERVICE_KEY
AUTH_SERVICE_KEY=CHANGE_ME_AUTH_SERVICE_KEY
FILE_SERVICE_KEY=CHANGE_ME_FILE_SERVICE_KEY
KNOWLEDGE_SERVICE_KEY=CHANGE_ME_KNOWLEDGE_SERVICE_KEY
GALGAME_SERVICE_KEY=CHANGE_ME_GALGAME_SERVICE_KEY
RENDER_SERVICE_KEY=CHANGE_ME_RENDER_SERVICE_KEY
PRACTICE_SERVICE_KEY=CHANGE_ME_PRACTICE_SERVICE_KEY
CREDIT_SERVICE_KEY=CHANGE_ME_CREDIT_SERVICE_KEY
MODEL_SERVICE_KEY=CHANGE_ME_MODEL_SERVICE_KEY

USER_MYSQL_ROOT_PASSWORD=CHANGE_ME_USER_MYSQL_ROOT_PASSWORD
USER_MYSQL_PASSWORD=CHANGE_ME_USER_MYSQL_PASSWORD
AUTH_MYSQL_ROOT_PASSWORD=CHANGE_ME_AUTH_MYSQL_ROOT_PASSWORD
AUTH_MYSQL_PASSWORD=CHANGE_ME_AUTH_MYSQL_PASSWORD
CREDIT_MYSQL_ROOT_PASSWORD=CHANGE_ME_CREDIT_MYSQL_ROOT_PASSWORD
CREDIT_MYSQL_PASSWORD=CHANGE_ME_CREDIT_MYSQL_PASSWORD
USER_SERVICE_MODE=MySql
AUTH_SERVICE_MODE=MySql

NEO4J_PASSWORD=CHANGE_ME_NEO4J_PASSWORD
GALREVIEW_ADMIN_USERNAME=CHANGE_ME_ADMIN_USERNAME
GALREVIEW_ADMIN_PASSWORD_HASH=CHANGE_ME_ASPNET_IDENTITY_PASSWORD_HASH
ACCOUNT_FRONTEND_BASE_URL=https://CHANGE_ME.example.com
CORS_ORIGINS=https://CHANGE_ME.example.com

GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_HOST_PORT=5000
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_HOST_PORT=5120
DIAGNOSTIC_BIND_ADDRESS=127.0.0.1
KNOWLEDGE_HOST_PORT=5104
NEO4J_BROWSER_HOST_PORT=5254
NEO4J_BOLT_HOST_PORT=5255
TRUST_PROXY=loopback

DEEPSEEK_API_KEY=
PRACTICE_QUESTION_ENDPOINT=https://api.deepseek.com/chat/completions
PRACTICE_QUESTION_MODEL=deepseek-v4-flash
PRACTICE_QUESTION_PARALLELISM=4
MODEL_NLI_MIN_TOP_PROBABILITY=0.75
MODEL_NLI_MIN_MARGIN=0.20

GALGAME_NARRATIVE_ENABLED=true
GALGAME_NARRATIVE_ENDPOINT=https://api.deepseek.com/chat/completions
GALGAME_NARRATIVE_MODEL=deepseek-v4-pro
GALGAME_VOICE_ENABLED=false
MIMO_API_KEY=
MIMO_TTS_ENDPOINT=https://api.xiaomimimo.com/v1/chat/completions
MIMO_TTS_MAX_CONCURRENCY=2

SMTP_HOST=
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=千知万理
