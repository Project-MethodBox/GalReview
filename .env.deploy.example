# Remote integration/staging deployment template.
# Copy to a server-local .env file and replace every CHANGE_ME value.
# Never commit the populated .env file.

COMPOSE_PROJECT_NAME=galreview

GATEWAY_KEY=CHANGE_ME_gateway_key
USER_SERVICE_KEY=CHANGE_ME_user_service_key
AUTH_SERVICE_KEY=CHANGE_ME_auth_service_key
FILE_SERVICE_KEY=CHANGE_ME_file_service_key
KNOWLEDGE_SERVICE_KEY=CHANGE_ME_knowledge_service_key
GALGAME_SERVICE_KEY=CHANGE_ME_galgame_service_key
RENDER_SERVICE_KEY=CHANGE_ME_render_service_key

NEO4J_PASSWORD=CHANGE_ME_neo4j_password
USER_MYSQL_ROOT_PASSWORD=CHANGE_ME_user_mysql_root_password
USER_MYSQL_PASSWORD=CHANGE_ME_user_mysql_password
AUTH_MYSQL_ROOT_PASSWORD=CHANGE_ME_auth_mysql_root_password
AUTH_MYSQL_PASSWORD=CHANGE_ME_auth_mysql_password
GALREVIEW_ADMIN_USERNAME=CHANGE_ME_admin_username
GALREVIEW_ADMIN_PASSWORD=CHANGE_ME_admin_password

# Optional SMTP delivery for password-reset messages. Leave all SMTP values empty
# only when password-reset email is intentionally disabled.
SMTP_HOST=CHANGE_ME_smtp_host
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USERNAME=CHANGE_ME_smtp_username
SMTP_PASSWORD=CHANGE_ME_smtp_authorization_code
SMTP_FROM_ADDRESS=CHANGE_ME_sender_address
SMTP_FROM_NAME=GalReview
ACCOUNT_FRONTEND_BASE_URL=https://CHANGE_ME.example

# The server template uses each service's contract-defined MySQL store.
# MySQL passwords are interpolated into connection strings; use high-entropy values
# without semicolons. Local integration may override both modes with Mock.
AUTH_SERVICE_MODE=MySql
USER_SERVICE_MODE=MySql

GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_HOST_PORT=5000
FRONTEND_BIND_ADDRESS=0.0.0.0
FRONTEND_HOST_PORT=8080
DIAGNOSTIC_BIND_ADDRESS=127.0.0.1
KNOWLEDGE_HOST_PORT=5080
NEO4J_BROWSER_HOST_PORT=7474
NEO4J_BOLT_HOST_PORT=7687

# Replace with the actual frontend origin(s), comma-separated.
CORS_ORIGINS=https://CHANGE_ME.example
