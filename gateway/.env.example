# Gateway 端口
GATEWAY_PORT=5000
GATEWAY_HOST=127.0.0.1

# Gateway 统一服务密钥（仅作为回退默认值，生产环境必须为每个服务配置独立密钥）
GATEWAY_KEY=moonstone-local-gateway-key

# 每服务独立密钥（生产环境强烈建议配置，避免单点故障）
# USER_SERVICE_KEY=
# AUTH_SERVICE_KEY=
# FILE_SERVICE_KEY=
# KNOWLEDGE_SERVICE_KEY=
# GALGAME_SERVICE_KEY=
# RENDER_SERVICE_KEY=
# PRACTICE_SERVICE_KEY=
# CREDIT_SERVICE_KEY=
# MODEL_SERVICE_KEY=

# CORS 允许的前端源（逗号分隔）
CORS_ORIGINS=http://localhost:5120,http://localhost:5121,http://localhost:5122

# 是否按 X-Forwarded-For 还原客户端 IP（影响匿名限流的分桶键）。
# 留空＝不采信该头（默认，最安全）：否则任何客户端轮换该头即可无限刷新匿名配额。
# 仅当 Gateway 只经可信反代对外时，填该代理的地址/网段或 Express 预设：
# TRUST_PROXY=172.18.0.0/16
# TRUST_PROXY=loopback
TRUST_PROXY=

# 超时配置（毫秒）
DEFAULT_TIMEOUT_MS=30000
UPLOAD_TIMEOUT_MS=120000

# /readyz 必须可达的核心服务 key（逗号分隔）
READINESS_SERVICES=userService,authService,fileService,knowledgeService,practiceService,creditService,modelService

# 下游服务地址
USER_SERVICE_URL=http://localhost:5101
AUTH_SERVICE_URL=http://localhost:5102
FILE_SERVICE_URL=http://localhost:5103
KNOWLEDGE_SERVICE_URL=http://localhost:5104
GALGAME_SERVICE_URL=http://localhost:5105
RENDER_SERVICE_URL=http://localhost:5106
PRACTICE_SERVICE_URL=http://localhost:5107
CREDIT_SERVICE_URL=http://localhost:5108
MODEL_SERVICE_URL=http://localhost:5109

# 限流配置
RL_ANONYMOUS_WINDOW_MS=60000
RL_ANONYMOUS_MAX=20
RL_UPLOAD_WINDOW_MS=60000
RL_UPLOAD_MAX=10
RL_GENERATION_WINDOW_MS=60000
RL_GENERATION_MAX=5
RL_GENERAL_WINDOW_MS=60000
RL_GENERAL_MAX=120
